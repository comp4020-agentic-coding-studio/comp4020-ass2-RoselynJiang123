---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import { withBase } from "astro-theme-university/url";
import PageLayout from "../../layouts/PageLayout.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import { formatCourseDate } from "../../lib/dates";
import { graphCollections, sessionLabels } from "../../site-config";

export async function getStaticPaths() {
  const sessions = await getPublishedCollection("sessions");
  return sessions.map((session) => ({ params: { slug: session.id }, props: { session } }));
}

const { session } = Astro.props;
const { Content } = await render(session);

const allSessions = await getPublishedCollection("sessions");
const prereqs = (session.data.prereqs ?? []) as number[];
const prereqSessions = prereqs
  .map((week) => allSessions.find((other) => other.data.week === week))
  .filter((other): other is (typeof allSessions)[number] => Boolean(other));
---

<PageLayout
  title={`Week ${session.data.week} ${sessionLabels.singular}: ${session.data.title}`}
  description={session.data.description ?? undefined}
  lead={false}
>
  <div class="kicker">
    {sessionLabels.singular} {session.data.week} · {session.data.phase}
  </div>
  <h1>{session.data.title}</h1>
  <hr class="rule" />

  <div class="meta">
    <span class="chip">Week {session.data.week}</span>
    <span class="chip">{formatCourseDate(session.data.date)}</span>
    <span class="chip">{session.data.format}</span>
    {
      prereqSessions.map((prereq) => (
        <span class="chip">
          Builds on <a href={withBase(`/sessions/${prereq.id}/`)}>Week {prereq.data.week}</a>
        </span>
      ))
    }
    {session.data.usesLadder && <span class="chip ladder">Uses the Ladder</span>}
  </div>

  <p class="lede">{session.data.description}</p>

  <div class="round-content">
    <Content />
  </div>

  <SpecList spec={session.data.spec}>
    What you bring to the session. Written so a reader can tell whether it has
    been met without asking you.
  </SpecList>
  <TeachingTeam teachers={session.data.teachers} />
  <RelatedContent entry={session} collections={graphCollections} />
</PageLayout>

<style>
  .kicker {
    color: var(--sham-drape);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }

  h1 {
    font-size: clamp(1.7rem, 4.5vw, 2.6rem);
    line-height: 1.1;
    margin: 0.5rem 0 0;
    letter-spacing: -0.015em;
  }

  .rule {
    height: 2px;
    background: var(--sham-incision);
    width: 7.5rem;
    margin: 1.1rem 0 1.25rem;
    border: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.9rem 0 0.25rem;
  }

  .chip {
    font-size: 0.85rem;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    border-radius: 999px;
    padding: 0.15rem 0.65rem;
  }

  .chip.ladder {
    border-color: var(--sham-drape);
    background: var(--sham-drape-tint);
    color: var(--sham-drape);
    font-weight: 600;
  }

  .lede {
    font-size: 1.1rem;
    max-width: 40rem;
  }

  .round-content :global(h2) {
    font-size: 1.3rem;
    margin: 2rem 0 0.5rem;
  }

  /* The four Round headings always end with "Protocol log", followed by one
     paragraph naming the protocol section — style that pair as a distinct
     log box rather than plain prose. */
  .round-content :global(h2:last-of-type) {
    color: var(--sham-drape);
    border: 1px solid var(--sham-drape);
    border-inline-start-width: 6px;
    padding: 0.85rem 1.1rem 0;
    margin-block-start: 1.75rem;
    margin-block-end: 0;
  }

  .round-content :global(h2:last-of-type + p) {
    border: 1px solid var(--sham-drape);
    border-inline-start-width: 6px;
    border-block-start: none;
    padding: 0 1.1rem 0.85rem;
    margin-block-start: 0;
  }
</style>
